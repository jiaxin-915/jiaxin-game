var baseScale float64
onStart => { baseScale = size }
onMsg "frame", => {
    if baseScale == 0 { baseScale = size }
    if Muted {
        show
        if pointerInside(mouseX, mouseY, xpos, ypos, 276*baseScale, 120*baseScale) { setSize(baseScale * 1.06) } else { setSize baseScale }
    } else { hide; setSize baseScale }
}
